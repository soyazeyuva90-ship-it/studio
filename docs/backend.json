
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user role and association data.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["parent", "child"] },
        "linkedParentUid": { "type": "string", "description": "For child accounts, the UID of the parent." },
        "displayName": { "type": "string" }
      },
      "required": ["uid", "role"]
    },
    "Device": {
      "title": "Device",
      "description": "Managed device metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "batteryLevel": { "type": "number" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "isOnline": { "type": "boolean" },
        "parentUid": { "type": "string" },
        "childUid": { "type": "string" },
        "currentLat": { "type": "number" },
        "currentLng": { "type": "number" }
      },
      "required": ["id", "parentUid"]
    },
    "CallLog": {
      "title": "Call Log",
      "description": "Log of incoming/outgoing calls including recording status.",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "contactName": { "type": "string" },
        "type": { "type": "string", "enum": ["incoming", "outgoing", "missed"] },
        "durationSeconds": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" },
        "isRecorded": { "type": "boolean" },
        "recordingUrl": { "type": "string" }
      },
      "required": ["deviceId", "phoneNumber", "type", "timestamp"]
    },
    "SmsLog": {
      "title": "SMS Log",
      "description": "History of text messages.",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "messageBody": { "type": "string" },
        "type": { "type": "string", "enum": ["inbox", "sent"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["deviceId", "phoneNumber", "messageBody", "timestamp"]
    },
    "NotificationLog": {
      "title": "Notification Log",
      "description": "Intercepted notifications from social media and other apps.",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string" },
        "appName": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["deviceId", "appName", "timestamp"]
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles and roles."
    },
    "/devices/{deviceId}": {
      "schema": "Device",
      "description": "Active managed devices."
    },
    "/devices/{deviceId}/calls/{callId}": {
      "schema": "CallLog",
      "description": "Historical call logs."
    },
    "/devices/{deviceId}/sms/{smsId}": {
      "schema": "SmsLog",
      "description": "Historical SMS logs."
    },
    "/devices/{deviceId}/notifications/{notifId}": {
      "schema": "NotificationLog",
      "description": "Intercepted notifications."
    }
  }
}

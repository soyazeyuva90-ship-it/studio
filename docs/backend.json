
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user role and association data.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["parent", "child"] },
        "displayName": { "type": "string" }
      },
      "required": ["uid", "role"]
    },
    "Device": {
      "title": "Device",
      "description": "Managed device metadata and real-time status.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "model": { "type": "string" },
        "osVersion": { "type": "string" },
        "batteryLevel": { "type": "number" },
        "isOnline": { "type": "boolean" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "settings": { "type": "object" }
      },
      "required": ["id", "userId"]
    },
    "CallLog": {
      "title": "Call Log",
      "type": "object",
      "properties": {
        "phoneNumber": { "type": "string" },
        "contactName": { "type": "string" },
        "type": { "type": "string", "enum": ["INCOMING", "OUTGOING", "MISSED"] },
        "duration": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "SmsLog": {
      "title": "SMS Log",
      "type": "object",
      "properties": {
        "address": { "type": "string" },
        "body": { "type": "string" },
        "type": { "type": "string", "enum": ["SENT", "RECEIVED"] },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "AppUsageLog": {
      "title": "App Usage Log",
      "type": "object",
      "properties": {
        "packageName": { "type": "string" },
        "appName": { "type": "string" },
        "durationSeconds": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "Command": {
      "title": "Device Command",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["SYNC_NOW", "LOCK_DEVICE", "RECORD_AUDIO", "PING"] },
        "status": { "type": "string", "enum": ["PENDING", "EXECUTED", "FAILED"] },
        "payload": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile"
    },
    "/devices/{deviceId}": {
      "schema": "Device"
    },
    "/devices/{deviceId}/calls/{id}": { "schema": "CallLog" },
    "/devices/{deviceId}/sms/{id}": { "schema": "SmsLog" },
    "/devices/{deviceId}/usage/{id}": { "schema": "AppUsageLog" },
    "/devices/{deviceId}/commands/{id}": { "schema": "Command" }
  }
}
